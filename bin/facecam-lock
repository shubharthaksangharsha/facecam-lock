#!/bin/bash
# FaceCam Lock launcher: picks the right Python and hands off to cli.py.

APP_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/facecam-lock"

for candidate in "${FACECAM_PYTHON:-}" "$DATA_DIR/venv/bin/python" "$APP_DIR/.venv/bin/python" /usr/bin/python3; do
  if [[ -n $candidate && -x $candidate ]]; then
    exec "$candidate" "$APP_DIR/cli.py" "$@"
  fi
done

echo "facecam-lock: no Python interpreter found" >&2
exit 1
